# Copy to .env — the npm run scripts load it automatically (node --env-file-if-exists).
# LOG_LEVEL=info            # debug | info | warn | error | silent

# ── Task 2 — MCP Security Gateway (port 3002) ───────────────────────────────
# HS256 signing secret shared with your token issuer (≥ 32 chars). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATEWAY_JWT_SECRET=
GATEWAY_JWT_ISSUER=quilr-auth
GATEWAY_JWT_AUDIENCE=quilr-mcp-gateway
# Downstream: leave DOWNSTREAM_URL empty to bridge to the Task 1 MCP server over stdio,
# or point it at an HTTP MCP endpoint (e.g. the mock: npm run mock-downstream → :3010).
DOWNSTREAM_URL=
DOWNSTREAM_TIMEOUT_MS=5000
# Extra tools that need role=admin besides the admin_* prefix (comma separated)
ADMIN_ONLY_TOOLS=

# ── Task 3 — LLM Streaming Guardrail (port 3003) ────────────────────────────
# Who may use the guardrail: clients send Authorization: Bearer <key>. Required (the server
# refuses to start without one, so it can't run as an open proxy on LLM_API_KEY).
# Format: clientId:key,clientId:key (keys ≥ 16 chars)
GUARDRAIL_API_KEYS=
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
UPSTREAM_HEADERS_TIMEOUT_MS=30000
UPSTREAM_IDLE_TIMEOUT_MS=30000

# ── Task 4 — Rate-Limiting Router (port 3004) ───────────────────────────────
# Tenants authenticate with Authorization: Bearer <key>. Format: tenantId:key,tenantId:key (keys ≥ 16 chars)
TENANT_API_KEYS=
MAX_TOKENS_PER_MINUTE=50000
# Output tokens reserved when a request has no max_tokens (≥ 1). Also sent to the provider as
# max_tokens, so a reply can never outgrow its reservation. Reconciled to actual usage afterwards.
DEFAULT_OUTPUT_RESERVATION=1024
PROVIDER_TIMEOUT_MS=3000
FAILOVER_MAX_JITTER_MS=200
DB_PATH=./rate_limiter.db
# Protects GET /metrics; when empty, /metrics is disabled
METRICS_TOKEN=

# Primary: any OpenAI-compatible Chat Completions API
PRIMARY_BASE_URL=https://api.openai.com
PRIMARY_API_KEY=
PRIMARY_MODEL=gpt-4o-mini
# Models tenants may request (comma separated). Defaults to PRIMARY_MODEL only.
ALLOWED_MODELS=

# Secondary: Claude Messages API (official SDK)
SECONDARY_API_KEY=
SECONDARY_MODEL=claude-opus-5-5
# SECONDARY_BASE_URL=
# Server-side refusal fallback on the Claude API; set to "off" behind proxies that reject beta parameters
ANTHROPIC_REFUSAL_FALLBACK=on
