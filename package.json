{
  "name": "quilr-ai-assessment",
  "version": "2.0.0",
  "description": "QuilrAI Technical Assessment — MCP Server, Security Gateway, LLM Streaming Guardrail, Rate-Limiting Router",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "task1": "node --env-file-if-exists=.env dist/task1-mcp-server/index.js",
    "task2": "node --env-file-if-exists=.env dist/task2-mcp-gateway/index.js",
    "task3": "node --env-file-if-exists=.env dist/task3-llm-guardrail/index.js",
    "task4": "node --env-file-if-exists=.env dist/task4-rate-limiter/index.js",
    "mock-downstream": "node --env-file-if-exists=.env dist/task2-mcp-gateway/mock-downstream/index.js",
    "token": "node --env-file-if-exists=.env dist/task2-mcp-gateway/mint-token.js",
    "demo": "node dist/demo/index.js",
    "simulate": "node --env-file-if-exists=.env dist/task4-rate-limiter/simulate/index.js",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "test:only": "node --test --test-concurrency=1 \"dist/tests/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.21.2",
    "gpt-tokenizer": "4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
